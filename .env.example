# APProved — optional configuration
#
# None of this is required. The app runs offline with no configuration at all.
# Copy to .env and edit only what you need.

# --- Server ---------------------------------------------------------------
PORT=5001
OPEN_BROWSER=1                      # set to 0 to stop it launching a browser tab
SECRET_KEY=dev-change-in-production  # signs the Flask session cookie

# --- LLM providers (optional) ---------------------------------------------
# Without these, generation uses the deterministic offline engine.
# Keys can also be typed into the UI per request; either way they are used for
# one call and never persisted or written to the audit trail.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
